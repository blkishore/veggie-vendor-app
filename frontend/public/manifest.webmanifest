{
  "name": "Veggie Vendor App",
  "short_name": "VeggieApp",
  "description": "Simple vendor and customer ordering for local vegetable carts.",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#f2f3ea",
  "theme_color": "#16281f",
  "icons": [
    {
      "src": "pwa-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "pwa-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Vendor mode",
      "short_name": "Vendor",
      "url": "/?mode=vendor",
      "description": "Open vendor dashboard quickly"
    },
    {
      "name": "Customer mode",
      "short_name": "Customer",
      "url": "/?mode=buyer",
      "description": "Open customer ordering quickly"
    }
  ]
}
